#include "Shared.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES

// Empty by default, Debug builds show "RUDDER isn't connected yet" and every
// analysis/Pro-verification call fails -- there is no separate staging backend
// yet, so point Debug at the same production Vercel deployment Release uses.
// Swap this for localhost:8787 (uncommented) when running the backend locally.
RUDDER_API_HOST = decide-mu-navy.vercel.app
