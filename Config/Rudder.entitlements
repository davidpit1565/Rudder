<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with RudderWidgetExtension so the widget can read the latest
	     decision without opening the app's SwiftData store directly. See
	     App/Services/WidgetBridge.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.rudder.app</string>
	</array>
</dict>
</plist>
