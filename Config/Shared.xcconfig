// Shared build settings for the RUDDER app target.
//
PRODUCT_NAME = Rudder
PRODUCT_BUNDLE_IDENTIFIER = com.rudder.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
INFOPLIST_FILE = Config/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Automatic

// --- Backend and legal URLs --------------------------------------------------
// TODO(release): fill these in. They are deliberately empty rather than pointing
// at a plausible-looking host: the app treats an empty or non-HTTPS value as
// absent, so an unconfigured build says "RUDDER isn't connected yet" and hides
// the legal links, instead of failing against a domain that does not exist or
// linking to a page that was never published.
//
// A URL cannot be written literally here because "//" starts a comment, so the
// scheme is assembled below.
HTTPS = https:/$()/

RUDDER_API_HOST =
RUDDER_API_BASE_URL = $(HTTPS)$(RUDDER_API_HOST)

RUDDER_PRIVACY_POLICY_HOST =
RUDDER_PRIVACY_POLICY_URL = $(HTTPS)$(RUDDER_PRIVACY_POLICY_HOST)
RUDDER_TERMS_HOST =
RUDDER_TERMS_URL = $(HTTPS)$(RUDDER_TERMS_HOST)
RUDDER_SUPPORT_HOST =
RUDDER_SUPPORT_URL = $(HTTPS)$(RUDDER_SUPPORT_HOST)
