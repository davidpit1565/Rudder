<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>RUDDER</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<!-- The app uses only standard HTTPS, which is exempt from export compliance. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Voice input on the home screen (App/Services/SpeechRecognizer.swift): both
	     are requested together, only when the user taps the microphone button. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>RUDDER uses your microphone to turn speech into text when you tap the microphone button.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>RUDDER uses speech recognition to turn what you say into the text of your decision.</string>
	<!--
	  RUDDER's own backend. The app never holds a model provider key: it talks
	  only to this endpoint, which keeps the credentials server-side.
	  Set RUDDER_API_HOST in Config/*.xcconfig before shipping.
	-->
	<key>RudderAPIBaseURL</key>
	<string>$(RUDDER_API_BASE_URL)</string>
	<key>RudderPrivacyPolicyURL</key>
	<string>$(RUDDER_PRIVACY_POLICY_URL)</string>
	<key>RudderTermsURL</key>
	<string>$(RUDDER_TERMS_URL)</string>
	<key>RudderSupportURL</key>
	<string>$(RUDDER_SUPPORT_URL)</string>
</dict>
</plist>
