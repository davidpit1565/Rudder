# The only place a model provider credential exists. Never ships in the app.
ANTHROPIC_API_KEY=sk-ant-...

# Port for the standalone server (ignored by serverless hosts).
PORT=8787

# Requests per window, per client, before the endpoint starts refusing.
DECIDE_RATE_LIMIT=20
DECIDE_RATE_WINDOW_SECONDS=60

# A second, much longer window behind the one above: bounds how much a single
# client can spend over a sustained period, not just how fast.
DECIDE_DAILY_LIMIT=200

# How many analyse() calls may run at once, across all clients. A backstop
# against concurrency abuse (many parallel connections, or many spoofed
# identities arriving together) that holds even if every client key above is
# unreliable.
DECIDE_MAX_CONCURRENT_ANALYSES=5

# Only set this to "1" if this server sits behind a reverse proxy / load
# balancer that YOU control and that itself sets x-forwarded-for — and only if
# the server is not *also* reachable directly (otherwise anyone can set that
# header themselves and get a fresh rate-limit budget on every request). Wrong
# either way: unset behind a real proxy, every client shares one bucket (the
# proxy's own address); set without locking the origin down, the header is
# forgeable. Default: trust nothing but the raw socket address.
# DECIDE_TRUST_PROXY=1

# Optional: require this bearer token on every request. See README — on its own
# this is not a substitute for App Attest, because anything shipped inside the
# app can be extracted from it.
# DECIDE_CLIENT_TOKEN=

# Set to "1" to refuse any request that does not carry an App Attest assertion.
# The verification itself is a TODO — see src/attest.ts.
DECIDE_REQUIRE_ATTESTATION=0

# Upstash Redis REST credentials (src/redis.ts). Required for the rate and
# concurrency limits above to actually hold on a serverless host: an
# in-process counter cannot survive a request landing on a different
# execution instance, which on Vercel is the normal case, not an edge case.
# Without these set, the limits above are not enforced. Left unset locally —
# the code falls back to an in-process counter, which is correct for one
# long-lived process.
# DECIDE_KV_KV_REST_API_URL=
# DECIDE_KV_KV_REST_API_TOKEN=

# How many "complex" (deep) decisions one install may spend without a
# verified Pro transaction, per calendar month (src/quota.ts). Keep in sync
# by hand with FeatureAccess.freeDeepDecisionsPerMonth in
# App/App/AppEnvironment.swift. Set low deliberately at bootstrap-stage
# volume -- raise it once real conversion data justifies the extra cost.
DECIDE_FREE_DEEP_DECISIONS_PER_MONTH=1

# The app's bundle identifier, checked against every Pro transaction
# (src/appStoreVerify.ts). Confirm this actually matches the Rudder target's
# PRODUCT_BUNDLE_IDENTIFIER before shipping.
DECIDE_BUNDLE_ID=com.rudder.app

# Only for tests: overrides the pinned Apple Root CA - G3 fingerprint
# src/appStoreVerify.ts verifies every transaction chain against. Never set
# this in production.
# DECIDE_APPLE_ROOT_FINGERPRINT=

# The absolute ceiling on total estimated Free-tier AI spend per calendar
# month, across every install combined (src/spendCeiling.ts). This is the
# backstop the per-install quota above doesn't give by itself: enough
# installs each spending their own small quota can still add up. Kept tight
# at bootstrap-stage volume -- raise it once real conversion data justifies
# carrying more cost. Never applies to a verified Pro transaction.
DECIDE_MONTHLY_FREE_SPEND_CEILING_USD=12
