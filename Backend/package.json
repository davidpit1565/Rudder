{
  "name": "rudder-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RUDDER's analysis endpoint. Holds the model provider credentials so the iPhone app never has to.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "tsc && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "compare-models": "tsc && node dist/scripts/compare-analysis-models.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "openai": "^7.32.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
